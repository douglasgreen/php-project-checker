{
  "name": "owner/package",
  "version": "1.0",
  "description": "***",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:sh && prettier --check .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:sh": "shellcheck **/*.sh",
    "format": "prettier --write . && markdownlint \"**/*.md\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0",
    "@zackad/prettier-plugin-twig": "^0.17",
    "eslint": "^10.8",
    "eslint-config-prettier": "^10.1",
    "eslint-plugin-playwright": "^2.11",
    "eslint-plugin-security": "^4.0",
    "eslint-plugin-unicorn": "^73.0",
    "eslint-plugin-vue": "^10.10",
    "eslint-plugin-yml": "^3.8",
    "globals": "^17.11",
    "markdownlint-cli": "^0.49",
    "prettier": "^3.9",
    "prettier-plugin-sh": "^0.19",
    "prettier-plugin-sql": "^0.20",
    "shellcheck": "^4.1",
    "stylelint": "^17.14",
    "stylelint-config-standard": "^40.0",
    "typescript-eslint": "^8.67",
    "vue-eslint-parser": "^10.4",
    "yaml-eslint-parser": "^2.1"
  }
}
