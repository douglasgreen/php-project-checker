{
  "name": "owner/package",
  "version": "1.0",
  "description": "***",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:sh",
    "lint:js": "eslint . --ext .js,.ts,.vue,.yml,.yaml",
    "lint:css": "stylelint '**/*.css'",
    "lint:md": "markdownlint '**/*.md'",
    "lint:sh": "shellcheck **/*.sh",
    "format": "prettier --write . && markdownlint '**/*.md' --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@zackad/prettier-plugin-twig": "^0.16",
    "eslint": "^9.39",
    "eslint-config-prettier": "^10.1",
    "eslint-plugin-jsx-a11y": "^6.10",
    "eslint-plugin-playwright": "^2.10",
    "eslint-plugin-prettier": "^5.5",
    "eslint-plugin-security": "^4.0",
    "eslint-plugin-unicorn": "^63.0",
    "eslint-plugin-vue": "^10.8",
    "eslint-plugin-yml": "^3.3",
    "globals": "^17.4",
    "markdownlint-cli": "^0.47",
    "prettier": "^3.8",
    "prettier-plugin-sh": "^0.18",
    "prettier-plugin-sql": "^0.19",
    "shellcheck": "^4.1",
    "stylelint": "^17.6",
    "stylelint-config-standard": "^40.0",
    "typescript-eslint": "^8.58",
    "vue-eslint-parser": "^10.4",
    "yaml-eslint-parser": "^2.0"
  }
}
