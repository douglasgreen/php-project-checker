parameters:
  level: 8
  phpVersion:
    min: 80300
    max: 80500
  paths:
    - bin
    - public
    - src
    - tests
  excludePaths:
    - var
    - vendor

  # Framework extensions (uncomment as needed)
  # symfony:
  #   container_xml_path: var/cache/dev/App_KernelDevDebugContainer.xml

  # Doctrine extension (uncomment as needed)
  # doctrine:
  #   objectManagerLoader: tests/object-manager.php
