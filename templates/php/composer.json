{
  "name": "owner/project",
  "description": "***",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.6"
  },
  "require-dev": {
    "carthage-software/mago": "^1.57",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "mago lint",
      "mago analyze",
      "mago guard"
    ],
    "lint:format": [
      "mago format"
    ],
    "lint:fix": [
      "mago lint --fix"
    ],
    "lint:upgrade": [
      "rector process"
    ],
    "test": [
      "phpunit"
    ],
    "test:unit": [
      "phpunit --testsuite=Unit"
    ],
    "test:integration": [
      "phpunit --testsuite=Integration"
    ],
    "qa": [
      "@lint",
      "@test"
    ]
  }
}
