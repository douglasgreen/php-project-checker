{
  "modified": "2026-03-19",
  "name": "douglasgreen/php-project-checker",
  "description": "Check PHP project files for conformance with requirements",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "carthage-software/mago": "^1.57",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "DouglasGreen\\PHPProjectChecker\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "mago lint",
      "mago analyze",
      "mago guard"
    ],
    "lint:format": [
      "mago format"
    ],
    "lint:fix": [
      "mago lint --fix"
    ],
    "lint:upgrade": [
      "rector process"
    ],
    "qa": [
      "@lint"
    ]
  }
}
