{
    "name": "douglasgreen/php-project-checker",
    "description": "A collection of PHP scripts to check project code for defects",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "douglasgreen/code-linter": "^0.5.1",
        "douglasgreen/code-metrics": "^0.5.1",
        "friendsofphp/php-cs-fixer": "^3.93.1",
        "phpstan/phpstan": "^2.1.38",
        "rector/rector": "^2.3.5"
    },
    "autoload": {
        "psr-4": {
            "DouglasGreen\\PHPProjectChecker\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "code_linter.php",
            "code_metrics.php",
            "php-cs-fixer fix --dry-run --verbose",
            "phpstan analyse",
            "rector process --dry-run"
        ],
        "lint:fix": [
            "php-cs-fixer fix",
            "rector process"
        ]
    }
}
